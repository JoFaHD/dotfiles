// Load with --load-config examples/2.jsonc
// Note that you must replace the image path to an existing image to display it.

{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "display": {
        "separator": " ",
        "bar": {
            "charElapsed": "=",
            "charTotal": "-",
            "width": 13
        },
        "percent": {
            "type": 1
        },
        "binaryPrefix": "jedec"
    },
    "modules": [
        "title",
        {
            "type": "command",
            "text": "date +%H:%M\\ \\-\\ %d.%m.%Y",
            "key": "Time and date:"
        },
        "separator",
        {
            "type": "custom",
            "format": " System",
            "outputColor": "blue"
        },
        {
            "type": "os",
            "key": "├─", // Just get your distro's logo off nerdfonts.com
            "keyColor": "blue"
        },
        {
            "type": "kernel",
            "key": "├─",
            "keyColor": "blue"
        },
        {
            "type": "packages",
            "key": "├─󰏖",
            "keyColor": "blue"
        },
        {
            "type": "uptime",
            "key": "├─󰅐",
            "keyColor": "blue"
        },
        {
            "type": "wifi",
            "key": "├─",
            "format": "{2} - {3} {7}% [{8} Mbit/s]", // ssid
            "keyColor": "blue"
        },
        {
            "type": "locale",
            "key": "└─",
            "keyColor": "blue"
        },
        "break",

        {
            "type": "custom",
            "format": "󰍛 Hardware",
            "outputColor": "green"
        },
        {
            "type": "host",
            "key": "├─󰌢",
            "format": "{2}",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "├─󰻠",
            "format": "{1} [@ {7} GHz] - {8}",
            "temp": true,
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "driverSpecific": true,
            "key": "├─󰍛",
            "format": "{1} {2} [{3}] - {4}",
            "temp": true,
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "├─󰑭",
            "keyColor": "green"
        },
        {
            "type": "display",
            "key": "├─󰍹",
            "compactType": "original-with-refresh-rate",
            "order": "asc",
            "keyColor": "green"
        },
        {
            "type": "battery",
            "key": "├─",
            "keyColor": "green"
        },
        {
            "type": "poweradapter",
            "key": "├─",
            "keyColor": "green"
        },
        {
            "type": "gamepad",
            "key": "├─",
            "keyColor": "green"
        },
        {
            "type": "bluetooth",
            "key": "├─",
            "keyColor": "green"
        },
        {
            "type": "sound",
            "key": "└─",
            "format": "{2} ({3})",
            "keyColor": "green"
        },
        "break",

        {
            "type": "custom",
            "format": " Software",
            "outputColor": "yellow"
        },
        {
            "type": "shell",
            "key": "├─",
            "keyColor": "yellow"
        },
        {
            "type": "terminal",
            "key": "├─",
            "keyColor": "yellow"
        },
        {
            "type": "terminalfont",
            "key": "├─",
            "keyColor": "yellow"
        },
        {
            "type": "editor",
            "key": "├─",
            "keyColor": "yellow"
        },
        {
            "type": "lm",
            "key": "├─󰧨",
            "keyColor": "yellow"
        },
        {
            "type": "de",
            "key": "├─",
            "keyColor": "yellow"
        },
        {
            "type": "wm",
            "key": "├─",
            "keyColor": "yellow"
        },
        "break",

        {
            "type": "custom",
            "format": "󰉼 Theming",
            "outputColor": "cyan"
        },
        {
            "type": "font",
            "key": "├─",
            "keyColor": "cyan"
        },
        {
            "type": "theme",
            "key": "├─󰉼",
            "keyColor": "cyan"
        },
        {
            "type": "icons",
            "key": "├─󰀻",
            "keyColor": "cyan"
        },
        {
            "type": "cursor",
            "key": "└─",
            "keyColor": "cyan"
        },
        "break",

        {
            "type": "custom",
            "format": " Miscellaneous",
            "outputColor": "white"
        },
        {
            "type": "media",
            "key": "├─󰝚",
            "keyColor": "white"
        },
        {
            "type": "colors",
            "symbol": "circle",
            "key": "└─ ",
            "keyColor": "white"
        }

    ]
}

